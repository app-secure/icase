PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/icase_db

# Secreto para firmar los JWT de autenticacion (OBLIGATORIO en produccion: minimo 32 caracteres aleatorios).
# Sin el, en desarrollo se usa uno aleatorio por proceso y las sesiones se pierden al reiniciar.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio
# Duracion de la sesion (formato de jsonwebtoken: 12h, 1d...)
JWT_EXPIRES_IN=12h
# Limpieza de uploads huérfanos: opt-in, simulación por defecto.
# Conserva fuentes referenciadas; cuarentena tras 7 días, purga 7 días después.
UPLOAD_CLEANUP_ENABLED=false
UPLOAD_CLEANUP_DRY_RUN=true
# Registro público: por defecto cerrado en producción y abierto en desarrollo.
# Habilitar temporalmente para crear las cuentas iniciales y luego cerrar.
AUTH_REGISTRATION_ENABLED=false

# Origenes del navegador autorizados por CORS, separados por coma.
# Vacio: en desarrollo solo http://localhost:5173; en produccion ninguno (mismo origen).
CORS_ORIGINS=http://localhost:5173
# Si hay un proxy inverso delante, indica cuantos saltos confiar (para ver la IP real en el limite de intentos).
# TRUST_PROXY=1
# Tamano maximo del cuerpo JSON
JSON_LIMIT=10mb

# Proveedor de IA activo ('deepseek' | 'gemini' | 'groq' | 'openrouter' | 'auto')
AI_PROVIDER=deepseek
AI_PROVIDER_ORDER=gemini,deepseek,groq,openrouter
# Intentos TOTALES por modelo Gemini (1 desactiva reintentos; máximo 4).
AI_TRANSIENT_RETRIES=3
# Espera exponencial con jitter; respeta Retry-After y el presupuesto global.
AI_RETRY_BASE_DELAY_MS=2000
AI_RETRY_MAX_DELAY_MS=15000
# Presupuesto global por generación de requisitos; independiente entre proyectos/peticiones.
AI_REQUIREMENTS_TIMEOUT_MS=180000
AI_REQUIREMENTS_REQUEST_TIMEOUT_MS=35000
AI_REQUIREMENTS_MAX_ATTEMPTS=8
AI_CIRCUIT_COOLDOWN_MS=300000

# DeepSeek API (deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini API
GEMINI_API_KEY=tu_clave_gemini_aqui
GEMINI_ANALYSIS_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_INGESTION_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Groq Cloud API
GROQ_API_KEY=tu_clave_groq_aqui
GROQ_ANALYSIS_MODELS=openai/gpt-oss-120b
GROQ_ANALYSIS_INPUT_BUDGET=3000
# El generador usa prompts compactos y ajusta lotes sin recortar el insumo.
# No es necesario elevar este valor para activar el fallback compacto.
GROQ_ANALYSIS_MAX_OUTPUT_TOKENS=4800
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenRouter API (fallback gratuito)
OPENROUTER_API_KEY=tu_clave_openrouter_aqui
OPENROUTER_ANALYSIS_MODELS=

# N8N / Orquestación
## Requisitos resilientes (opt-in; no modifica diagramas, mockups ni código).
REQUIREMENTS_RESILIENT_ENABLED=false
# Confirma el perfil gratuito de las cuentas antes de incluirlas. Vacío: excluidas.
AI_FREE_TIER_PROVIDERS=
GEMINI_ACCOUNT_ID=default
GROQ_ACCOUNT_ID=default
OPENROUTER_ACCOUNT_ID=default
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_REQUIREMENTS_BATCH_OBJECTIVES=2
OLLAMA_REQUIREMENTS_OUTPUT_TOKENS=4096

N8N_WEBHOOK_URL=http://localhost:5678/webhook/icase-orchestrator

# Proveedor de IA para mockups ('gemini' | 'groq' | 'openrouter')
MOCKUP_IA_PROVIDER=gemini
MOCKUP_PROVIDER_ORDER=gemini,groq,openrouter
# Listas separadas por coma. Mantén solo modelos habilitados para tus cuentas.
GEMINI_MOCKUP_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GROQ_MOCKUP_MODELS=openai/gpt-oss-120b
# Vacío por defecto: OpenRouter cambia con frecuencia qué modelos son gratuitos.
OPENROUTER_MOCKUP_MODELS=
MOCKUP_PROMPT_FILE=disenador_mockups_compacto.md
MOCKUP_CIRCUIT_FAILURES=2
MOCKUP_CIRCUIT_COOLDOWN_MS=300000
GROQ_MOCKUP_INPUT_BUDGET=3000
GROQ_MOCKUP_MAX_OUTPUT_TOKENS=4800
