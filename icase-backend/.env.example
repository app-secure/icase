PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/icase_db
# Proveedor de IA activo ('deepseek' | 'gemini' | 'groq' | 'auto')
AI_PROVIDER=deepseek

# DeepSeek API (deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini API
GEMINI_API_KEY=tu_clave_gemini_aqui

# Groq Cloud API
GROQ_API_KEY=tu_clave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# N8N / Orquestación
N8N_WEBHOOK_URL=http://localhost:5678/webhook/icase-orchestrator

# Proveedor de IA para mockups
MOCKUP_IA_PROVIDER=gemini

# Habilitar/deshabilitar generación de imágenes de mockups
MOCKUP_IMAGES_ENABLED=false

# Cloudflare (opcional para generación/hosting de imágenes)
CF_ACCOUNT_ID=tu_cloudflare_account_id
CF_API_TOKEN=tu_cloudflare_api_token
