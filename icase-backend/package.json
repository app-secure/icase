{
  "name": "icase-backend",
  "version": "1.0.0",
  "description": "Backend I-CASE Agentica con Clean Architecture",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "test:requirements": "jest tests/requirement-coverage.test.js tests/requirement-analysis-contract.test.js tests/requirement-granularity.test.js tests/requirement-diagnostics.test.js tests/requirement-approval.test.js tests/ai-request-budget.test.js tests/multiple-evidence.test.js tests/pending-need-resolution.test.js tests/requirement-semantic-review.test.js tests/requirement-review-workflow.test.js tests/requirement-review-http.test.js tests/requirement-review-component.test.js tests/requirements-evaluation.test.js --runInBand",
    "test:requirements:safety": "jest tests/requirement-refinement-safety.test.js tests/requirement-recovery-evidence.test.js tests/requirement-quality.test.js tests/requirement-diagnostics-component.test.js tests/ai-retry-policy.test.js tests/requirement-objective-repair.test.js tests/requirement-semantic-contrast.test.js --runInBand",
    "test:requirements:real": "node scripts/evaluate-requirements-real.cjs --run-real",
    "test:requirements:resilience": "jest tests/requirements-resilient.test.js tests/requirements-jobs-http.test.js tests/requirements-jobs-repository.test.js --runInBand",
    "test:requirements:browser": "node scripts/test-requirements-browser.cjs",
    "test:initial-analysis": "jest tests/initial-analysis-separation.test.js tests/initial-analysis-workflow.test.js tests/initial-analysis-quality.test.js tests/analysis-identifiers.test.js tests/initial-analysis-tasks.test.js --runInBand",
    "test:initial-analysis:browser": "node scripts/test-initial-analysis-browser.cjs",
    "test:browser:install": "node scripts/install-test-browser.cjs",
    "verify:nm": "node scripts/verify-associations-runtime.js",
    "audit:generated": "node scripts/audit-generated-backend.js",
    "test:e2e:real": "env RUN_REAL_AI_E2E=true jest tests/real-model-flow.e2e.test.js --runInBand",
    "proyectos:asignar": "node scripts/asignar-proyectos-huerfanos.js"
  },
  "keywords": [
    "icase",
    "express",
    "mongoose",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "parse5": "7.3.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jest": "^29.7.0",
    "jose": "^6.2.15",
    "jsdom": "^26.0.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^6.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "swagger-ui-dist": "^5.18.2"
  }
}
