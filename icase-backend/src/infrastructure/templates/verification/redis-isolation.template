import {test} from 'node:test';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';
import bridge from '../support/redis-bridge.cjs';
test('Redis compartido: namespaces de aplicaciones no se cruzan',{skip:!process.env.TEST_REDIS_URL},async()=>{
 const received=[],other=[],clients=[],group='verification-'+randomUUID();
 try{
  for(const [namespace,sink] of [[group,received],[group,received],[group+'-other',other]])clients.push(await bridge.createRedisBridge({url:process.env.TEST_REDIS_URL,namespace,receive:async event=>sink.push(event),onFailure:()=>{}}));
  await clients[0].publish({keys:['rf-01'],method:'PATCH'});
  for(let attempt=0;attempt<50&&!received.length;attempt++)await new Promise(resolve=>setTimeout(resolve,20));
  assert.deepEqual(received,[{keys:['rf-01'],method:'PATCH'}]);await new Promise(resolve=>setTimeout(resolve,100));assert.deepEqual(other,[]);
 }finally{for(const client of clients)await client.close();}
});
